{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "orchestrator",
  "permission": "allow",
  "agent": {
    "explore": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "model": "ollama/kimi-k3:cloud"
    },
    "cartographer": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "designer": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "docs-writer": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "duckdb-specialist": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "feature-lead": {
      "model": "ollama/glm-5.3:cloud"
    },
    "frontend-vue": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "infra-platform": {
      "model": "ollama/kimi-k3:cloud"
    },
    "ionic-cross-platform": {
      "model": "ollama/glm-5.3:cloud"
    },
    "janitor": {
      "model": "ollama/kimi-k3:cloud"
    },
    "orchestrator": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "principal": {
      "model": "ollama/kimi-k3:cloud"
    },
    "qa-tester": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "rails-backend": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "rails-backend-watchmaker": {
      "model": "ollama/kimi-k3:cloud"
    },
    "redteam": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "security-guardian": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "sprinter": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "watchmaker": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "frontend-vue-watchmaker": {
      "model": "ollama/kimi-k3:cloud"
    },
    "image-analyst": {
      "model": "ollama/kimi-k3:cloud"
    }
  },
  "plugin": [
    "opencode-browser"
  ],
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "kimi-k3:cloud": {
          "name": "kimi-k3"
        },
        "glm-5.2:cloud": {
          "name": "glm-5.2"
        },
        "glm-5.3:cloud": {
          "name": "glm-5.3"
        },
        "glm-5.3-flash:cloud": {
          "name": "glm-5.3-flash"
        },
        "deepseek-v4-flash:0731-cloud": {
          "name": "deepseek-v4-flash"
        }
      }
    }
  }
}
