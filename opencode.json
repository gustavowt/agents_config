{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "orchestrator",
  "permission": "allow",
  "agent": {
    "explore": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "model": "ollama/kimi-k3:cloud"
    },
    "cartographer": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "designer": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "docs-writer": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "frontend-vue": {
      "model": "ollama/deepseek-v4.1-flash:cloud"
    },
    "infra-platform": {
      "model": "ollama/kimi-k3:cloud"
    },
    "janitor": {
      "model": "ollama/deepseek-v4.1-flash:cloud"
    },
    "orchestrator": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "principal": {
      "model": "ollama/kimi-k3:cloud"
    },
    "qa-tester": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "rails-backend": {
      "model": "ollama/deepseek-v4.1-flash:cloud"
    },
    "rails-backend-watchmaker": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "redteam": {
      "model": "ollama/mistral-large-4:cloud"
    },
    "security-guardian": {
      "model": "ollama/mistral-large-4:cloud"
    },
    "sprinter": {
      "model": "ollama/deepseek-v4.1-flash:cloud"
    },
    "watchmaker": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "frontend-vue-watchmaker": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "image-analyst": {
      "model": "ollama/kimi-k3:cloud"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1"
      ],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "kimi-k3:cloud": {
          "name": "kimi-k3"
        },
        "glm-5.2:cloud": {
          "name": "glm-5.2"
        },
        "glm-5.3:cloud": {
          "name": "glm-5.3"
        },
        "glm-5.3-flash:cloud": {
          "name": "glm-5.3-flash"
        },
        "deepseek-v4.1-flash:cloud": {
          "name": "deepseek-v4-flash"
        },
        "mistral-large-4:cloud": {
          "name": "mistral-large-4"
        }
      }
    }
  }
}
